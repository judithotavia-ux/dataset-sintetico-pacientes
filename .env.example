# Copie para .env e ajuste se necessário. Nenhuma variável aqui deve conter dados pessoais.

# Pasta onde ficam o banco SQLite, os artefatos gerados e as exportações
DATA_DIR=./data

# Banco de dados (padrão: SQLite em DATA_DIR/synthetic_patients.db).
# Exemplo PostgreSQL: postgresql+psycopg://usuario:senha@localhost:5432/synthetic
# DATABASE_URL=sqlite:///./data/synthetic_patients.db

# Seed padrão sugerido para reprodutibilidade
DEFAULT_SEED=42

# Origens autorizadas a acessar a API (frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nível de log (DEBUG, INFO, WARNING, ERROR). Os logs são apenas técnicos.
LOG_LEVEL=INFO

# Frontend (opcional): URL da API quando não usar o proxy do Vite
# VITE_API_URL=http://localhost:8000/api
